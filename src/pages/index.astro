---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero3DCanvas from '../components/Hero3DCanvas.astro';
import HeroBackground from '../components/HeroBackground.astro';
import '../styles/home.css';
---

<BaseLayout
  title="Catalise.me · Sistemas Inteligentes Consultáveis por IA"
  description="Transformamos empresas em sistemas inteligentes consultáveis por IA. Menos piloto, mais inteligência em produção."
  ogTitle="Catalise.me · Sistemas Inteligentes Consultáveis por IA"
  ogDescription="Transformamos empresas em sistemas inteligentes consultáveis por IA."
  ogUrl="https://catalise.me/"
  canonical="https://catalise.me/"
  pageType="home"
  showFooter={false}
>

  <!-- ══════════════ HERO SINGLE-SECTION (Estilo Brabaflow.ai) ══════════════ -->
  <section class="hero-editorial" aria-labelledby="hero-heading" id="hero">

    <!-- Fundo Arquitetural Hairline -->
    <HeroBackground className="hero-bg-layer" />

    <!-- Elemento 3D Interativo (Three.js Monocromático Wireframe) -->
    <Hero3DCanvas />

    <!-- Conteúdo Principal da Seção Única -->
    <div class="hero-content-wrapper">
      <div class="hero-main-column">

        <!-- Badge de Status / Manifesto (Kokonut / Manus style) -->
        <div class="hero-badge-wrap">
          <a href="/manifesto" class="hero-badge hero-animate-1" aria-label="Ler o Manifesto da Catalise.me">
            <span class="badge-pulse" aria-hidden="true"></span>
            <span>Leia nosso manifesto sobre IA para empresas</span>
            <span class="badge-arrow" aria-hidden="true">→</span>
          </a>
        </div>

        <!-- Chamada Principal Solicitada (H1) -->
        <h1 id="hero-heading" class="hero-editorial-heading hero-animate-2">
          Transformamos empresas em sistemas inteligentes consultáveis por IA
        </h1>

        <!-- Subtítulo / Apoio Operacional -->
        <p class="hero-subtitle hero-animate-3">
          Ampliamos sua capacidade operacional com inteligência artificial: adoção prática, sistemas confiáveis e governança em produção.
        </p>

        <!-- Cluster de Ação (CTAs) -->
        <div class="hero-ctas-editorial hero-animate-4">
          <button type="button" class="btn btn-primary btn-lg" data-open-modal aria-label="Entrar em contato">
            Entrar em Contato <span class="btn-arrow" aria-hidden="true">→</span>
          </button>
          <a href="/manifesto" class="btn btn-secondary btn-lg" aria-label="Ler o Manifesto">
            Ler Manifesto
          </a>
        </div>

      </div>
    </div>

    <!-- Barra Inferior de Métricas, Status e Aplicações (Single-Section Baseline) -->
    <footer class="hero-bottom-bar" aria-label="Informações operacionais e ecossistema de aplicações">
      <div class="hero-bottom-inner">
        <div class="hero-bottom-status">
          <span class="status-dot-active" aria-hidden="true"></span>
          <span>Catalise.me // Sistemas Operacionais com IA em Produção</span>
        </div>

        <ul class="hero-bottom-pillars" role="list">
          <li class="pillar-item">
            <span>01</span>
            <strong>Adoção Prática</strong>
          </li>
          <li class="pillar-sep" aria-hidden="true">/</li>
          <li class="pillar-item">
            <span>02</span>
            <strong>Sistemas Confiáveis</strong>
          </li>
          <li class="pillar-sep" aria-hidden="true">/</li>
          <li class="pillar-item">
            <span>03</span>
            <strong>Governança Ativa</strong>
          </li>
        </ul>
      </div>

      <!-- Linha Inferior com Logos das Aplicações -->
      <div class="hero-apps-row">
        <div class="hero-apps-inner">
          <span class="hero-apps-label">Nossas Aplicações</span>
          <div class="hero-apps-list" aria-label="Aplicações desenvolvidas pela Catalise.me">
            <div class="app-logo-item" title="Opera aiOS">
              <img src="/assets/apps/logo-app-opera.png" alt="Opera aiOS" class="app-logo-img app-logo-opera" width="57" height="24" loading="lazy" />
            </div>
            <span class="app-sep" aria-hidden="true">/</span>
            <div class="app-logo-item" title="Matika AI CRM">
              <img src="/assets/apps/logo-app-matika.png" alt="Matika AI CRM" class="app-logo-img app-logo-matika" width="81" height="22" loading="lazy" />
            </div>
            <span class="app-sep" aria-hidden="true">/</span>
            <div class="app-logo-item" title="BrandQuest by catalise.me">
              <img src="/assets/apps/logo-app-brandquest.png" alt="BrandQuest by catalise.me" class="app-logo-img app-logo-brandquest" width="97" height="20" loading="lazy" />
            </div>
            <span class="app-sep" aria-hidden="true">/</span>
            <div class="app-logo-item" title="Yugen">
              <img src="/assets/apps/logo-app-yugen.png" alt="Yugen" class="app-logo-img app-logo-yugen" width="75" height="21" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </footer>

  </section>

</BaseLayout>
