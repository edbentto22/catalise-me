---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero3DCanvas from '../components/Hero3DCanvas.astro';
import HeroBackground from '../components/HeroBackground.astro';
import '../styles/home.css';

// Simulação ilustrativa do que uma empresa consultável responde e executa.
const queries = [
  { q: 'Quais clientes não compram há mais de 60 dias?', a: '37 clientes · ticket médio em queda', act: 'Campanha de reativação criada no CRM' },
  { q: 'Onde o onboarding de novos clientes está travando?', a: 'Etapa 3 · aprovação de contrato · 4,2 dias', act: 'Lembrete automático enviado ao responsável' },
  { q: 'Qual processo mais consome horas da equipe?', a: 'Conciliação financeira · 22 h por semana', act: 'Agente de conciliação ativado com revisão humana' },
  { q: 'Quem aprovou essa exceção e por quê?', a: 'Diretoria comercial · margem acima da política', act: 'Decisão registrada na base de conhecimento' },
];
const [firstQuery] = queries;
const pillars = ['Conhecimento', 'Processos', 'Sistemas', 'Agentes'];
---

<BaseLayout
  title="Catalise.me · Empresas consultáveis"
  description="Construímos empresas consultáveis: capazes de responder sobre clientes, processos, dados e operações, e de agir sobre essas respostas com IA em produção."
  ogTitle="Catalise.me · Empresas consultáveis"
  ogDescription="A próxima geração de empresas não será apenas digital. Será consultável."
  ogUrl="https://catalise.me/"
  canonical="https://catalise.me/"
  pageType="home"
  showFooter={false}
>

  <!-- ══════════════ HERO SINGLE-SECTION (Estilo Brabaflow.ai) ══════════════ -->
  <section class="hero-editorial" aria-labelledby="hero-heading" id="hero">

    <!-- Fundo Arquitetural Hairline -->
    <HeroBackground className="hero-bg-layer" />

    <!-- Elemento 3D Interativo (Three.js Monocromático Wireframe) -->
    <Hero3DCanvas />

    <!-- Conteúdo Principal da Seção Única -->
    <div class="hero-content-wrapper">
      <div class="hero-main-column">

        <!-- Badge de Status / Manifesto (Kokonut / Manus style) -->
        <div class="hero-badge-wrap">
          <a href="/manifesto" class="hero-badge hero-animate-1" aria-label="Ler o Manifesto: Empresas consultáveis">
            <span class="badge-pulse" aria-hidden="true"></span>
            <span>Manifesto · Empresas consultáveis</span>
            <span class="badge-arrow" aria-hidden="true">→</span>
          </a>
        </div>

        <!-- Chamada Principal (H1) -->
        <h1 id="hero-heading" class="hero-editorial-heading hero-animate-2">
          Construímos empresas <em>consultáveis</em>.
        </h1>

        <!-- Subtítulo / Tese -->
        <p class="hero-subtitle hero-animate-3">
          A próxima geração de empresas não será apenas digital. Será consultável: capaz de responder sobre seus clientes, processos, dados e operações. E de agir sobre essas respostas.
        </p>

        <!-- Cluster de Ação (CTAs) -->
        <div class="hero-ctas-editorial hero-animate-4">
          <button type="button" class="btn btn-primary btn-lg" data-open-modal aria-label="Entrar em contato">
            Tornar minha empresa consultável <span class="btn-arrow" aria-hidden="true">→</span>
          </button>
          <a href="/manifesto" class="btn btn-secondary btn-lg" aria-label="Ler o Manifesto">
            Ler o Manifesto
          </a>
        </div>

      </div>

      <!-- Console: pergunte à sua empresa (simulação ilustrativa) -->
      <aside class="query-console" data-cx-fade data-query-console data-queries={JSON.stringify(queries)} aria-label="Exemplo de consulta a uma empresa consultável">
        <div class="query-console-head">
          <span class="query-console-live"><span class="query-console-dot" aria-hidden="true"></span>Pergunte à sua empresa</span>
          <span class="query-console-index"><span data-query-index>01</span>/0{queries.length}</span>
        </div>

        <p class="query-console-q">
          <span class="query-console-prompt" aria-hidden="true">›</span>
          <span data-query-q>{firstQuery.q}</span>
        </p>

        <div class="query-console-body" aria-live="polite">
          <p class="query-console-row" data-query-answer>
            <span class="query-console-label">Resposta</span>
            <span data-query-a>{firstQuery.a}</span>
          </p>
          <p class="query-console-row query-console-action" data-query-action>
            <span class="query-console-check" aria-hidden="true">
              <svg viewBox="0 0 16 16"><path data-query-check d="M3.5 8.5 L6.5 11.5 L12.5 4.5" /></svg>
            </span>
            <span data-query-act>{firstQuery.act}</span>
          </p>
        </div>

        <div class="query-console-foot">
          <span data-query-status>Resposta + ação executada</span>
          <span class="query-console-note">Simulação ilustrativa</span>
        </div>
      </aside>
    </div>

    <!-- Barra Inferior de Métricas, Status e Aplicações (Single-Section Baseline) -->
    <footer class="hero-bottom-bar" aria-label="Informações operacionais e ecossistema de aplicações">
      <div class="hero-bottom-inner">
        <div class="hero-bottom-status">
          <span class="status-dot-active" aria-hidden="true"></span>
          <span>Catalise.me // Empresas consultáveis</span>
        </div>

        <ul class="hero-bottom-pillars" role="list" aria-label="A camada que conectamos">
          {pillars.map((pillar, i) => (
            <>
              {i > 0 && <li class="pillar-sep" aria-hidden="true">/</li>}
              <li class="pillar-item">
                <span>{String(i + 1).padStart(2, '0')}</span>
                <strong>{pillar}</strong>
              </li>
            </>
          ))}
        </ul>
      </div>

      <!-- Linha Inferior com Logos das Aplicações -->
      <div class="hero-apps-row">
        <div class="hero-apps-inner">
          <span class="hero-apps-label">Nossas Aplicações</span>
          <div class="hero-apps-list" aria-label="Aplicações desenvolvidas pela Catalise.me">
            <div class="app-logo-item" title="Opera aiOS">
              <img src="/assets/apps/logo-app-opera.png" alt="Opera aiOS" class="app-logo-img app-logo-opera" width="57" height="24" loading="lazy" />
            </div>
            <span class="app-sep" aria-hidden="true">/</span>
            <div class="app-logo-item" title="Matika AI CRM">
              <img src="/assets/apps/logo-app-matika.png" alt="Matika AI CRM" class="app-logo-img app-logo-matika" width="81" height="22" loading="lazy" />
            </div>
            <span class="app-sep" aria-hidden="true">/</span>
            <div class="app-logo-item" title="BrandQuest by catalise.me">
              <img src="/assets/apps/logo-app-brandquest.png" alt="BrandQuest by catalise.me" class="app-logo-img app-logo-brandquest" width="97" height="20" loading="lazy" />
            </div>
            <span class="app-sep" aria-hidden="true">/</span>
            <div class="app-logo-item" title="Yugen">
              <img src="/assets/apps/logo-app-yugen.png" alt="Yugen" class="app-logo-img app-logo-yugen" width="75" height="21" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </footer>

  </section>

</BaseLayout>
