---
import BaseLayout from '../layouts/BaseLayout.astro';
import Ambient3D from '../components/Ambient3D.astro';
import '../styles/inner.css';
import '../styles/manifesto.css';

// Onde a inteligência da empresa vive hoje. x/y = posição conectada (anel);
// sx/sy/sr = deslocamento quando ainda está espalhada (fração do palco e rotação).
const fragments = [
  { icon: 'brain', label: 'Na cabeça das pessoas', x: 50, y: 11, sx: -0.28, sy: 0.13, sr: -7 },
  { icon: 'database', label: 'Nos sistemas', x: 83, y: 30, sx: -0.09, sy: -0.16, sr: 6 },
  { icon: 'messages-square', label: 'Nas conversas', x: 83, y: 70, sx: -0.53, sy: -0.08, sr: -4 },
  { icon: 'sheet', label: 'Nas planilhas', x: 50, y: 89, sx: 0.3, sy: -0.37, sr: 9 },
  { icon: 'file-text', label: 'Nos documentos', x: 17, y: 70, sx: 0.43, sy: 0.16, sr: -11 },
  { icon: 'workflow', label: 'Em processos que ninguém escreveu', x: 17, y: 30, sx: 0.29, sy: 0.08, sr: 7 },
];

const beliefs = [
  { not: 'Não acreditamos em IA como espetáculo.', yes: 'IA é meio.' },
  { not: 'Não acreditamos em soluções que servem para qualquer empresa.', yes: 'Específico vence genérico.' },
  { not: 'Não acreditamos em relatórios que deixam a execução para depois.', yes: 'Implementamos.' },
  { not: 'Não acreditamos em sistemas que são abandonados depois da entrega.', yes: 'Evoluímos.' },
  { not: 'E não acreditamos que crescimento deva significar mais esforço.', yes: 'Sistema vence esforço.' },
];

const cycle = [
  { word: 'Entender', text: 'Entender o que acontece.' },
  { word: 'Decidir', text: 'Decidir o que fazer.' },
  { word: 'Executar', text: 'Executar.' },
  { word: 'Medir', text: 'Medir.' },
  { word: 'Aprender', text: 'Aprender.' },
  { word: 'Evoluir', text: 'E evoluir.' },
];

// Nós do ciclo no anel (centro 200,200 · raio 150), começando no topo.
const cycleNodes = cycle.map((_, i) => {
  const angle = -Math.PI / 2 + (i * Math.PI * 2) / cycle.length;
  return { x: 200 + Math.cos(angle) * 150, y: 200 + Math.sin(angle) * 150 };
});

const layerSources = ['Conhecimento', 'Processos', 'Sistemas', 'Agentes'];
const layerX = [180, 440, 760, 1020];
---

<BaseLayout
  title="Manifesto · Empresas consultáveis · Catalise.me"
  description="A próxima geração de empresas não será apenas digital. Será consultável. O manifesto da Catalise.me sobre empresas capazes de responder sobre si mesmas e de agir sobre essas respostas."
  ogTitle="Empresas consultáveis · O manifesto da Catalise.me"
  ogDescription="A próxima geração de empresas não será apenas digital. Será consultável."
  ogUrl="https://catalise.me/manifesto"
  canonical="https://catalise.me/manifesto"
  pageType="inner"
>

  <div class="mf-read-progress" data-read-progress aria-hidden="true"></div>

  <!-- ══════════════ HERO · A TESE ══════════════ -->
  <header class="mf-hero" data-mf-hero aria-labelledby="manifesto-heading">
    <Ambient3D variant="converge" />

    <div class="container mf-hero-inner">
      <span class="page-hero-eyebrow" data-cx-fade>Manifesto // Catalise.me</span>

      <h1 id="manifesto-heading" class="mf-hero-title" data-mf-title data-cx-hero>
        Empresas <em>consultáveis.</em>
      </h1>

      <div class="mf-hero-thesis">
        <p data-cx-fade>
          A próxima geração de empresas não será apenas
          <span class="mf-strike" data-strike>digital<span class="mf-strike-line" data-strike-line aria-hidden="true"></span></span>.
        </p>
        <p class="mf-hero-thesis-strong" data-cx-fade>
          Será <span class="mf-scramble" data-scramble>consultável</span>.
        </p>
      </div>

      <div class="mf-hero-meta" data-cx-fade>
        <span>Tese de posicionamento</span>
        <span class="mf-hero-meta-sep" aria-hidden="true">/</span>
        <span>Leitura · 2 min</span>
        <a href="#definicao" class="mf-scroll-cue">
          Ler o manifesto
          <span class="mf-scroll-cue-line" aria-hidden="true"></span>
        </a>
      </div>
    </div>
  </header>

  <!-- ══════════════ 01 · DEFINIÇÃO ══════════════ -->
  <section id="definicao" class="mf-section mf-define" aria-label="O que é uma empresa consultável">
    <div class="container mf-narrow">
      <span class="mf-index">01 · A tese</span>

      <p class="mf-scrub" data-scrub>
        Empresas capazes de responder sobre seus <mark>clientes</mark>, <mark>processos</mark>, <mark>dados</mark>, <mark>decisões</mark> e <mark>operações</mark>.
      </p>

      <p class="mf-aside" data-reveal>E, mais importante:</p>

      <p class="mf-punch" data-punch>
        capazes de <span class="mf-underline">agir<svg class="mf-underline-svg" viewBox="0 0 120 14" preserveAspectRatio="none" aria-hidden="true" data-no-split><path data-underline d="M2 9 C 30 3, 70 3, 118 8" /></svg></span> sobre essas respostas.
      </p>
    </div>
  </section>

  <!-- ══════════════ 02 · ESPALHADA → CONECTADA ══════════════ -->
  <section id="espalhada" class="mf-section mf-scatter" data-scatter aria-label="A inteligência da empresa está espalhada">
    <div class="container mf-scatter-grid">
      <div class="mf-scatter-copy">
        <span class="mf-index">02 · O problema</span>

        <div class="mf-steps">
          <div class="mf-step is-active" data-step>
            <h2>Hoje, a inteligência de uma empresa está <em>espalhada.</em></h2>
          </div>
          <div class="mf-step" data-step>
            <h2>A informação existe.<br><em>Mas não conversa.</em></h2>
          </div>
          <div class="mf-step" data-step>
            <h2>A Catalise existe para <em>mudar isso.</em></h2>
          </div>
        </div>

        <div class="mf-scatter-track" aria-hidden="true"><span data-scatter-progress></span></div>
      </div>

      <div class="mf-stage" data-stage>
        <svg class="mf-stage-lines" aria-hidden="true">
          {fragments.map((f) => (
            <line data-link x1="50%" y1="50%" x2={`${f.x}%`} y2={`${f.y}%`} />
          ))}
        </svg>

        <div class="mf-core" data-core>
          <span class="mf-core-mark" aria-hidden="true">✱</span>
          <span>Catalise</span>
        </div>

        <ul class="mf-frags" role="list">
          {fragments.map((f) => (
            <li
              class="mf-frag"
              data-frag
              data-sx={f.sx}
              data-sy={f.sy}
              data-sr={f.sr}
              style={`--x:${f.x}%; --y:${f.y}%`}
            >
              <span class="mf-frag-icon"><i data-lucide={f.icon} aria-hidden="true"></i></span>
              <span class="mf-frag-label">{f.label}</span>
              <span class="mf-frag-dot" aria-hidden="true"></span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ══════════════ 03 · A CAMADA ══════════════ -->
  <section id="camada" class="mf-section mf-layer" aria-labelledby="camada-heading">
    <div class="container">
      <div class="mf-layer-head">
        <span class="mf-index">03 · A camada</span>
        <h2 id="camada-heading" class="mf-layer-title" data-reveal>
          Construímos a camada que conecta conhecimento, processos, sistemas e agentes.
        </h2>
      </div>

      <div class="mf-layer-diagram" data-layer>
        <svg class="mf-layer-svg" viewBox="0 0 1200 440" aria-hidden="true">
          <!-- Fontes → camada -->
          {layerX.map((x) => <path class="mf-layer-path" data-layer-path d={`M${x} 360 V244`} />)}
          <!-- Camada → IA -->
          {layerX.map((x) => <path class="mf-layer-path" data-layer-path d={`M${x} 196 C ${x} 130, 600 150, 600 84`} />)}

          <!-- Rotas invisíveis para os pulsos -->
          {layerX.map((x) => <path class="mf-route" data-route-up d={`M${x} 360 V196 C ${x} 130, 600 150, 600 84`} />)}
          {layerX.map((x) => <path class="mf-route" data-route-down d={`M600 84 C 600 150, ${x} 130, ${x} 196 V360`} />)}

          {layerX.map(() => <circle class="mf-pulse mf-pulse-up" data-pulse-up r="5" cx="0" cy="0" />)}
          {layerX.map(() => <circle class="mf-pulse mf-pulse-down" data-pulse-down r="4" cx="0" cy="0" />)}
        </svg>

        <div class="mf-layer-node mf-layer-ai" data-layer-node style="--x:50%; --y:13%">
          <i data-lucide="sparkles" aria-hidden="true"></i>
          Inteligência artificial
        </div>

        <div class="mf-layer-bar" data-layer-bar>
          <span class="mf-layer-bar-mark" aria-hidden="true">✱</span>
          Camada Catalise
        </div>

        <ul class="mf-layer-sources" role="list">
          {layerSources.map((label, i) => (
            <li class="mf-layer-node mf-layer-source" data-layer-node style={`--x:${(layerX[i] / 1200) * 100}%; --y:88%`}>
              {label}
            </li>
          ))}
        </ul>
      </div>

      <div class="mf-layer-purpose" data-reveal-group>
        <p>
          <span class="mf-arrow" aria-hidden="true">↑</span>
          <span>Para que a empresa possa ser <strong>entendida pela inteligência artificial.</strong></span>
        </p>
        <p>
          <span class="mf-arrow mf-arrow-down" aria-hidden="true">↓</span>
          <span>E para que a inteligência artificial possa <strong>trabalhar dentro dela.</strong></span>
        </p>
      </div>
    </div>
  </section>

  <!-- ══════════════ 04 · CRENÇAS ══════════════ -->
  <section id="crencas" class="mf-section mf-beliefs" aria-labelledby="crencas-heading">
    <div class="container">
      <div class="mf-beliefs-head">
        <span class="mf-index">04 · Princípios</span>
        <h2 id="crencas-heading" class="mf-section-title" data-reveal>
          O que recusamos. <em>E o que fazemos no lugar.</em>
        </h2>
      </div>

      <ol class="mf-belief-list" role="list">
        {beliefs.map((belief, i) => (
          <li class="mf-belief" data-belief>
            <span class="mf-belief-num" data-belief-num>{String(i + 1).padStart(2, '0')}</span>
            <p class="mf-belief-not">
              <span class="mf-belief-not-text" data-belief-not>{belief.not}</span>
            </p>
            <p class="mf-belief-yes" data-belief-yes>{belief.yes}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ══════════════ 05 · O CICLO ══════════════ -->
  <section id="ciclo" class="mf-section mf-loop" data-loop aria-labelledby="ciclo-heading">
    <div class="container mf-loop-grid">
      <div class="mf-loop-copy">
        <span class="mf-index">05 · O ciclo</span>
        <h2 id="ciclo-heading" class="mf-section-title" data-reveal>
          É assim que construímos <em>empresas consultáveis.</em>
        </h2>
        <p class="mf-loop-lede">Empresas que conseguem:</p>

        <ol class="mf-loop-list" role="list">
          {cycle.map((step, i) => (
            <li class="mf-loop-item" data-loop-item data-word={step.word} tabindex="0">
              <span class="mf-loop-item-num">{String(i + 1).padStart(2, '0')}</span>
              <span>{step.text}</span>
            </li>
          ))}
        </ol>
      </div>

      <div class="mf-loop-visual" aria-hidden="true">
        <svg class="mf-loop-svg" viewBox="0 0 400 400">
          <circle class="mf-loop-guide" cx="200" cy="200" r="150" />
          <path class="mf-loop-ring" data-loop-ring d="M200 50 A150 150 0 1 1 199.99 50" />
          {cycleNodes.map((node) => (
            <circle class="mf-loop-node" data-loop-node cx={node.x} cy={node.y} r="6" />
          ))}
          <circle class="mf-loop-traveler" data-loop-traveler r="9" cx="0" cy="0" />
        </svg>

        {cycle.map((step, i) => (
          <span
            class="mf-loop-label"
            data-loop-label
            style={`--x:${(cycleNodes[i].x / 400) * 100}%; --y:${(cycleNodes[i].y / 400) * 100}%`}
          >
            {step.word}
          </span>
        ))}

        <div class="mf-loop-center">
          <span class="mf-loop-count" data-loop-count>01</span>
          <strong class="mf-loop-word" data-loop-word>Entender</strong>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════ ASSINATURA + CTA ══════════════ -->
  <section class="cta-section mf-sign" aria-labelledby="manifesto-cta-heading">
    <div class="container mf-sign-inner">
      <p class="mf-sign-brand" data-sign-brand data-text="Catalise.">Catalise.</p>
      <h2 id="manifesto-cta-heading" class="mf-sign-title" data-reveal>Empresas consultáveis.</h2>
      <p data-reveal>
        Vamos descobrir o que a sua empresa já sabe, e o que ela poderia responder e executar sozinha.
      </p>
      <div class="cta-buttons" data-reveal>
        <button type="button" class="btn btn-primary btn-lg" data-open-modal aria-label="Entrar em contato">
          Tornar minha empresa consultável <span class="btn-arrow" aria-hidden="true">→</span>
        </button>
        <a href="/sobre" class="btn btn-secondary btn-lg">
          Conhecer a Catalise
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
