---
import SEOHead from '../components/SEOHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ModalDiagnostico from '../components/ModalDiagnostico.astro';
import FloatingDock from '../components/FloatingDock.astro';
import CustomCursor from '../components/CustomCursor.astro';
import type { Locale } from '../i18n/config';
import { translatedLocales } from '../i18n/routes';
import { ui } from '../i18n/ui';

import '@fontsource-variable/archivo/wght.css';
import '@fontsource-variable/archivo/wght-italic.css';
import '@fontsource-variable/manrope/wght.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/animations.css';
import 'lenis/dist/lenis.css';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogUrl?: string;
  ogImage?: string;
  canonical?: string;
  bodyClass?: string;
  pageType?: 'home' | 'inner' | 'error';
  showFooter?: boolean;
  showModal?: boolean;
  showDock?: boolean;
  noindex?: boolean;
  keywords?: string;
  locale?: Locale;
  localizedPaths?: Partial<Record<Locale, string>>;
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogUrl,
  ogImage,
  canonical,
  bodyClass = '',
  pageType = 'inner',
  showFooter = true,
  showModal = true,
  showDock = true,
  noindex = false,
  keywords,
  locale = 'pt',
  localizedPaths,
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalUrl = canonical || new URL(currentPath, Astro.site || Astro.url.origin).toString();
const basePath = locale === 'pt' ? currentPath : currentPath.replace(new RegExp(`^/${locale}(?=/|$)`), '') || '/';
const generatedPaths = translatedLocales.length > 1
  ? Object.fromEntries(translatedLocales.map((language) => [language, language === 'pt' ? basePath : `/${language}${basePath === '/' ? '' : basePath}`])) as Partial<Record<Locale, string>>
  : undefined;
// A página de erro não tem equivalentes por idioma (evita hreflang e seletor apontando para /en/404).
const allLocalizedPaths = pageType === 'error' ? undefined : (localizedPaths || generatedPaths);
const t = ui[locale];
---

<!DOCTYPE html>
<html lang={locale === 'pt' ? 'pt-BR' : locale === 'en' ? 'en-US' : 'es-419'} class="no-js" data-motion="full">
<head>
  <SEOHead
    title={title}
    description={description}
    ogTitle={ogTitle || title}
    ogDescription={ogDescription || description}
    ogUrl={ogUrl}
    ogImage={ogImage}
    canonical={canonicalUrl}
    noindex={noindex}
    keywords={keywords}
    locale={locale}
    localizedPaths={allLocalizedPaths}
  />
  <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={manropeLatin} as="font" type="font/woff2" crossorigin>
  <!-- Decide o modo de movimento antes do primeiro paint e esconde só o que será coreografado. -->
  <script is:inline>
    (function () {
      var root = document.documentElement;
      var c = navigator.connection;
      var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches || (c && (c.saveData || /(^|-)2g$/.test(c.effectiveType || '')));
      root.dataset.motion = reduced ? 'reduced' : 'full';
      root.classList.remove('no-js');
      root.classList.add('js');
      if (reduced) return;
      root.classList.add('cx-preload');
      setTimeout(function () { root.classList.remove('cx-preload'); }, 3000);
    })();
  </script>
</head>
<body class={bodyClass} data-page-type={pageType}>

  <a class="skip-link" href="#main-content">{t.skip}</a>

  <Nav currentPath={currentPath} locale={locale} localizedPaths={allLocalizedPaths} />

  <main id="main-content" tabindex="-1">
    <slot />
  </main>

  {showFooter && <Footer locale={locale} />}
  {showModal && <ModalDiagnostico />}
  {showDock && <FloatingDock locale={locale} />}
  <CustomCursor />

  <!-- Um único controlador progressivo para navegação, movimento e componentes. -->
  <script>
    import Lenis from 'lenis';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import { initMotion } from '../scripts/motionController';
    import { initConsultable } from '../scripts/consultable';
    import {
      createIcons, Activity, BarChart3, BookOpen, Bot, Brain, Check, Clock, Compass, Database,
      FileText, Globe, LayoutGrid, Layers, Lock, Mail, MessageCircle, MessageSquare, MessagesSquare,
      Monitor, PenTool, Plus, RefreshCw, Rocket, Search, Sheet, Sparkles, Target, Users, Workflow, X,
    } from 'lucide';

    const root = document.documentElement;
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const coarsePointer = matchMedia('(pointer: coarse)').matches;
    const connection = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
    const saveData = Boolean(connection?.saveData);
    const slowConnection = ['slow-2g', '2g'].includes(connection?.effectiveType || '');
    // Efeitos de ponteiro e scroll suave: só com mouse; movimento em geral vale também para toque.
    const allowEffects = !reduceMotion && !coarsePointer && !saveData && !slowConnection;
    const allowAutoplay = !reduceMotion && !saveData && !slowConnection;
    const allowMotion = !reduceMotion && !saveData && !slowConnection;
    root.dataset.motion = allowMotion ? 'full' : 'reduced';
    root.dataset.pointer = coarsePointer ? 'coarse' : 'fine';

    createIcons({ icons: {
      Activity, BarChart3, BookOpen, Bot, Brain, Check, Clock, Compass, Database, FileText, Globe,
      LayoutGrid, Layers, Lock, Mail, MessageCircle, MessageSquare, MessagesSquare, Monitor, PenTool,
      Plus, RefreshCw, Rocket, Search, Sheet, Sparkles, Target, Users, Workflow, X,
    } });

    root.classList.add('js-enabled');
    initMotion();

    let lenis: Lenis | null = null;
    if (allowEffects) {
      lenis = new Lenis({ duration: 1.1, smoothWheel: true });
      lenis.on('scroll', ScrollTrigger.update);
      const raf = (time: number) => { lenis?.raf(time); requestAnimationFrame(raf); };
      requestAnimationFrame(raf);
    }

    initConsultable({ motion: allowMotion, pointer: allowEffects, lenis });

    // ─── Navegação: some ao descer, volta ao subir ───
    const nav = document.querySelector<HTMLElement>('[data-nav]');
    const hamburger = document.querySelector<HTMLButtonElement>('.nav-hamburger');
    const mobileMenu = document.querySelector<HTMLElement>('.nav-mobile');
    let menuFocusBefore: HTMLElement | null = null;
    let lastY = scrollY;
    let scrollQueued = false;

    const updateNav = () => {
      const y = scrollY;
      nav?.classList.toggle('scrolled', y > 20);
      const menuOpen = hamburger?.getAttribute('aria-expanded') === 'true';
      if (!menuOpen) nav?.classList.toggle('is-hidden', y > 480 && y > lastY + 2);
      if (y < lastY - 2 || y < 480) nav?.classList.remove('is-hidden');
      lastY = y;
      scrollQueued = false;
    };
    addEventListener('scroll', () => { if (!scrollQueued) { scrollQueued = true; requestAnimationFrame(updateNav); } }, { passive: true });
    updateNav();
    nav?.addEventListener('focusin', () => nav.classList.remove('is-hidden'));

    // ─── Menu em tela cheia ───
    const setMenuLabel = (open: boolean) => {
      if (!hamburger) return;
      hamburger.setAttribute('aria-expanded', String(open));
      hamburger.setAttribute('aria-label', (open ? hamburger.dataset.labelClose : hamburger.dataset.labelOpen) || '');
    };
    const closeMenu = (restore = true) => {
      if (!mobileMenu || !mobileMenu.classList.contains('open')) return;
      setMenuLabel(false);
      mobileMenu.classList.remove('open');
      document.body.classList.remove('menu-open');
      lenis?.start();
      const hide = () => { if (!mobileMenu.classList.contains('open')) mobileMenu.hidden = true; };
      setTimeout(hide, 750);
      if (restore) menuFocusBefore?.focus();
    };
    const openMenu = () => {
      if (!hamburger || !mobileMenu) return;
      menuFocusBefore = document.activeElement as HTMLElement;
      mobileMenu.hidden = false;
      void mobileMenu.offsetHeight;
      mobileMenu.classList.add('open');
      setMenuLabel(true);
      nav?.classList.remove('is-hidden');
      document.body.classList.add('menu-open');
      lenis?.stop();
      setTimeout(() => mobileMenu.querySelector<HTMLElement>('a')?.focus(), 200);
    };
    hamburger?.addEventListener('click', () => (hamburger.getAttribute('aria-expanded') === 'true' ? closeMenu() : openMenu()));
    mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => closeMenu(false)));
    document.addEventListener('cx:menu-close', () => closeMenu(false));
    matchMedia('(min-width: 1081px)').addEventListener('change', (event) => { if (event.matches) closeMenu(false); });
    document.addEventListener('keydown', (event) => {
      if (hamburger?.getAttribute('aria-expanded') !== 'true' || !mobileMenu) return;
      if (event.key === 'Escape') { closeMenu(); return; }
      if (event.key !== 'Tab') return;
      const focusable = [hamburger, ...mobileMenu.querySelectorAll<HTMLElement>('a, button:not([disabled])')];
      const first = focusable[0], last = focusable.at(-1);
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
      if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
    });

    // ─── Âncoras e "voltar ao topo" com o scroll suave ───
    document.addEventListener('click', (event) => {
      const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[href^="#"]');
      if (!link || !lenis) return;
      const id = link.getAttribute('href')!.slice(1);
      const target = id ? document.getElementById(id) : null;
      if (!target) return;
      event.preventDefault();
      lenis.scrollTo(target, { offset: id === 'main-content' ? 0 : -80 });
    });

    // ─── Revelação genérica ───
    const revealElements = [...document.querySelectorAll<HTMLElement>('.reveal')];
    if (!('IntersectionObserver' in window) || !allowMotion) {
      revealElements.forEach((el) => el.classList.add('revealed'));
    } else {
      const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('revealed');
        observer.unobserve(entry.target);
      }), { threshold: 0.12, rootMargin: '0px 0px -48px' });
      revealElements.forEach((el) => observer.observe(el));
    }

    // ─── FAQ acessível ───
    document.querySelectorAll<HTMLElement>('.faq-item').forEach((item, index) => {
      const button = item.querySelector<HTMLButtonElement>('.faq-question');
      const panel = item.querySelector<HTMLElement>('.faq-answer');
      if (!button || !panel) return;
      if (!panel.id) panel.id = `faq-panel-${index + 1}`;
      if (!button.id) button.id = `faq-button-${index + 1}`;
      button.setAttribute('aria-controls', panel.id);
      panel.setAttribute('role', 'region');
      panel.setAttribute('aria-labelledby', button.id);
      const sync = (open: boolean) => {
        button.setAttribute('aria-expanded', String(open));
        item.classList.toggle('open', open);
        panel.style.height = open ? `${panel.scrollHeight}px` : '0px';
      };
      sync(button.getAttribute('aria-expanded') === 'true');
      button.addEventListener('click', () => sync(button.getAttribute('aria-expanded') !== 'true'));
    });

    // ─── Vídeos sob demanda ───
    const activateVideo = (video: HTMLVideoElement) => {
      if (!allowAutoplay) return;
      if (!video.src) {
        const source = video.dataset.src;
        if (!source) return;
        video.src = source;
        video.load();
      }
      video.play().catch(() => {});
    };
    const videos = [...document.querySelectorAll<HTMLVideoElement>('video[data-src]')];

    videos.forEach((video) => {
      const mediaFrame = video.closest<HTMLElement>('[data-media-frame]');
      const markLoaded = () => {
        video.classList.add('loaded');
        mediaFrame?.classList.add('media-loaded');
      };
      if (video.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) markLoaded();
      else video.addEventListener('loadeddata', markLoaded, { once: true });
      video.addEventListener('error', () => {
        video.classList.remove('loaded');
        mediaFrame?.classList.remove('media-loaded');
        mediaFrame?.classList.add('media-failed');
      });
    });

    if (!('IntersectionObserver' in window)) {
      videos.forEach(activateVideo);
    } else {
      const mediaObserver = new IntersectionObserver((entries) => entries.forEach((entry) => {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) activateVideo(video);
        else video.pause();
      }), { rootMargin: '180px 0px', threshold: 0.1 });
      videos.forEach((video) => mediaObserver.observe(video));
    }
  </script>

</body>
</html>
