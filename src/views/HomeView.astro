---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero3DCanvas from '../components/Hero3DCanvas.astro';
import HeroBackground from '../components/HeroBackground.astro';
import { localizedHref, type Locale } from '../i18n/config';
import { home } from '../i18n/content/home';
import '../styles/home.css';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = home[locale];
const [firstQuery] = t.queries;
const pageUrl = `https://catalise.me${localizedHref('/', locale)}`;

const apps = [
  { src: '/assets/apps/logo-app-opera.png', alt: 'Opera aiOS', cls: 'app-logo-opera', w: 57, h: 24 },
  { src: '/assets/apps/logo-app-matika.png', alt: 'Matika AI CRM', cls: 'app-logo-matika', w: 81, h: 22 },
  { src: '/assets/apps/logo-app-brandquest.png', alt: 'BrandQuest by catalise.me', cls: 'app-logo-brandquest', w: 97, h: 20 },
  { src: '/assets/apps/logo-app-yugen.png', alt: 'Yugen', cls: 'app-logo-yugen', w: 75, h: 21 },
];
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  ogDescription={t.meta.ogDescription}
  ogUrl={pageUrl}
  canonical={pageUrl}
  pageType="home"
  showDock={false}
  locale={locale}
>

  <!-- ══════════════ HERO · SEÇÃO ÚNICA ══════════════ -->
  <section class="hero-editorial" aria-labelledby="hero-heading" id="hero">

    <HeroBackground className="hero-bg-layer" />

    <div class="hero-content-wrapper">
      <div class="hero-main-column">

        <h1 id="hero-heading" class="hero-editorial-heading" set:html={t.heading} />

        <p class="hero-subtitle hero-animate-3">{t.subtitle}</p>

        <div class="hero-ctas-editorial hero-animate-4">
          <button type="button" class="btn btn-primary btn-lg" data-open-modal data-magnetic>
            {t.ctaPrimary} <span class="btn-arrow" aria-hidden="true">→</span>
          </button>
          <a href={localizedHref('/opera-os', locale)} class="btn btn-secondary btn-lg">
            {t.ctaSecondary}
          </a>
        </div>
        <p class="hero-diagnostic-note">{t.diagnosticNote}</p>
        <a href={localizedHref('/manifesto', locale)} class="hero-manifesto-link" aria-label={t.badgeAria}>{t.badge} <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
      </div>

      <!-- Console: pergunte à sua empresa (simulação ilustrativa) -->
      <aside class="query-console" data-query-console data-queries={JSON.stringify(t.queries)} data-busy={t.console.busy} data-done={t.console.done} aria-label={t.console.aria}>
        <div class="query-network" aria-hidden="true">
          <Hero3DCanvas />
          <div class="query-network-labels">
            <span>{t.console.network}</span>
            <span>{t.console.flow}</span>
          </div>
        </div>
        <div class="query-console-head">
          <span class="query-console-live"><span class="query-console-dot" aria-hidden="true"></span>{t.console.label}</span>
          <span class="query-console-index"><span data-query-index>01</span>/0{t.queries.length}</span>
        </div>

        <p class="query-console-q">
          <span class="query-console-prompt" aria-hidden="true">›</span>
          <span data-query-q>{firstQuery.q}</span>
        </p>

        <div class="query-console-body">
          <p class="query-console-row" data-query-answer>
            <span class="query-console-label">{t.console.answer}</span>
            <span data-query-a>{firstQuery.a}</span>
          </p>
          <p class="query-console-row query-console-action" data-query-action>
            <span class="query-console-check" aria-hidden="true">
              <svg viewBox="0 0 16 16"><path data-query-check d="M3.5 8.5 L6.5 11.5 L12.5 4.5" /></svg>
            </span>
            <span data-query-act>{firstQuery.act}</span>
          </p>
        </div>

        <div class="query-console-foot">
          <span data-query-status>{t.console.done}</span>
          <span class="query-console-note">{t.console.note}</span>
        </div>
        <div class="query-console-controls" data-query-controls hidden>
          <button type="button" data-query-prev aria-label={t.console.previous}>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><path d="m14 6-6 6 6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
          <button type="button" data-query-next>{t.console.next}
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><path d="m10 6 6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
        </div>
        <p class="visually-hidden" data-query-announcement aria-live="polite" aria-atomic="true"></p>
      </aside>
    </div>

    <!-- Barra inferior: status, pilares da camada e aplicações -->
    <footer class="hero-bottom-bar">
      <div class="hero-bottom-inner">
        <div class="hero-bottom-status">
          <span>{t.status}</span>
        </div>

        <ul class="hero-bottom-pillars" role="list" aria-label={t.pillarsAria}>
          {t.pillars.map((pillar, i) => (
            <li class="pillar-item">
              <span>{String(i + 1).padStart(2, '0')}</span>
              <strong>{pillar}</strong>
            </li>
          ))}
        </ul>
      </div>
    </footer>

  </section>

  <!-- ══════════════ CAMINHOS · OPERA OS E PROJETOS SOB MEDIDA ══════════════ -->
  <section class="home-paths" aria-labelledby="paths-heading">
    <div class="container">
      <h2 id="paths-heading" class="home-paths-title" data-reveal set:html={t.paths.title} />
      <p class="home-paths-note">{t.pathsNote}</p>

      <div class="home-paths-grid" data-reveal-group>
        {t.paths.items.map((item, i) => (
          <article class="home-path">
            <h3>{item.name}</h3>
            <p class="home-path-audience">{item.audience}</p>
            <p class="home-path-text">{item.text}</p>
            {i === 0 ? (
              <a href={localizedHref('/opera-os', locale)} class="home-path-link">{item.cta} <span aria-hidden="true">→</span></a>
            ) : (
              <button type="button" class="home-path-link" data-open-modal>{item.cta} <span aria-hidden="true">→</span></button>
            )}
          </article>
        ))}
      </div>

      <div class="home-apps">
        <div>
          <h2 class="home-apps-label">{t.appsLabel}</h2>
          <p class="home-apps-note">{t.appsNote}</p>
        </div>
        <ul class="hero-apps-list" role="list" aria-label={t.appsAria}>
          {apps.map((app) => (
            <li class="app-logo-item">
              <img src={app.src} alt={app.alt} class:list={['app-logo-img', app.cls]} width={app.w} height={app.h} loading="lazy" decoding="async" />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

</BaseLayout>
