---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBackground from '../components/HeroBackground.astro';
import HeroGraph from '../components/HeroGraph.astro';
import { localizedHref, type Locale } from '../i18n/config';
import { home } from '../i18n/content/home';
import '../styles/home.css';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = home[locale];
const [firstWord] = t.headingWords;
const pageUrl = `https://catalise.me${localizedHref('/', locale)}`;

const apps = [
  { src: '/assets/apps/logo-app-opera.png', alt: 'Opera aiOS', cls: 'app-logo-opera', w: 57, h: 24 },
  { src: '/assets/apps/logo-app-matika.png', alt: 'Matika AI CRM', cls: 'app-logo-matika', w: 81, h: 22 },
  { src: '/assets/apps/logo-app-brandquest.png', alt: 'BrandQuest by catalise.me', cls: 'app-logo-brandquest', w: 97, h: 20 },
  { src: '/assets/apps/logo-app-yugen.png', alt: 'Yugen', cls: 'app-logo-yugen', w: 75, h: 21 },
];
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  ogDescription={t.meta.ogDescription}
  ogUrl={pageUrl}
  canonical={pageUrl}
  pageType="home"
  showDock={false}
  locale={locale}
>

  <!-- ══════════════ HERO · DOBRA ÚNICA · texto + rede ══════════════ -->
  <section class="hero-editorial" aria-labelledby="hero-heading" id="hero">

    <HeroBackground className="hero-bg-layer" />

    <div class="hero-content-wrapper">
      <div class="hero-main-column">

        <h1 id="hero-heading" class="hero-editorial-heading">
          <span class="hero-line">{t.headingLead}</span>
          <span class="hero-rotator" data-hero-rotator data-words={JSON.stringify(t.headingWords)} aria-hidden="true">
            <span class="hero-rotator-plus">+</span> <span class="hero-rotator-word" data-rotator-word>{firstWord}</span><span class="hero-rotator-caret"></span>
          </span>
          <span class="visually-hidden" data-no-split>+ {t.headingWordsAria}</span>
          <em class="hero-line hero-line-thesis">{t.headingThesis}</em>
        </h1>

        <p class="hero-subtitle hero-animate-3">{t.subtitle}</p>

        <div class="hero-ctas-editorial hero-animate-4">
          <button type="button" class="btn btn-primary btn-lg" data-open-modal data-magnetic>
            {t.ctaPrimary} <span class="btn-arrow" aria-hidden="true">→</span>
          </button>
        </div>
        <a href={localizedHref('/manifesto', locale)} class="hero-manifesto-link" aria-label={t.badgeAria}>{t.badge} <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
      </div>

      <!-- A empresa consultável como árvore radial: núcleo, hubs por domínio e leques de folhas -->
      <div class="hero-graph-column">
        {/* Os hubs são os quatro pilares. Cada palavra do título acende o pilar que a resolve:
            ferramentas → Sistemas · processos desconexos → Processos · vendas perdidas → Agentes · atendimento demorado → Conhecimento */}
        <HeroGraph core={t.graph.core} hubs={t.pillars} note={t.graph.note} aria={t.graph.aria} controls={t.graph.controls} legend={t.graph.legend} focusMap={[2, 1, 3, 0]} />
      </div>
    </div>

    <!-- Barra inferior: status, pilares da camada e aplicações próprias -->
    <footer class="hero-bottom-bar">
      <div class="hero-bottom-inner">
        <div class="hero-bottom-status">
          <span>{t.status}</span>
        </div>

        <ul class="hero-bottom-pillars" role="list" aria-label={t.pillarsAria}>
          {t.pillars.map((pillar, i) => (
            <li class="pillar-item">
              <span>{String(i + 1).padStart(2, '0')}</span>
              <strong>{pillar}</strong>
            </li>
          ))}
        </ul>

        <ul class="hero-apps-list" role="list" aria-label={t.appsAria}>
          {apps.map((app) => (
            <li class="app-logo-item">
              <img src={app.src} alt={app.alt} class:list={['app-logo-img', 'theme-light-only', app.cls]} width={app.w} height={app.h} loading="lazy" decoding="async" />
              <img src={app.src.replace('.png', '-on-dark.png')} alt={app.alt} class:list={['app-logo-img', 'theme-dark-only', app.cls]} width={app.w} height={app.h} loading="lazy" decoding="async" />
            </li>
          ))}
        </ul>
      </div>
    </footer>

  </section>

</BaseLayout>
