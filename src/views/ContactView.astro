---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlassScene from '../components/GlassScene.astro';
import { localizedHref, type Locale } from '../i18n/config';
import { contact } from '../i18n/content/contact';
import { leadForm, revenueValues, sourceValues } from '../i18n/content/leadForm';
import { ui, EMAIL, WHATSAPP_DISPLAY, whatsappLink } from '../i18n/ui';
import '../styles/inner.css';
import '../styles/manifesto.css';
import '../styles/contact.css';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = contact[locale];
const pageUrl = `https://catalise.me${localizedHref('/contato', locale)}`;
const whatsapp = whatsappLink(ui[locale].whatsappDiagnostic);
const f = leadForm[locale];
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  ogDescription={t.meta.ogDescription}
  ogUrl={pageUrl}
  canonical={pageUrl}
  pageType="inner"
  showDock={false}
  locale={locale}
>

  <!-- ══════════════ CONTATO · uma dobra: título e canais à esquerda, formulário à direita ══════════════ -->
  <section id="formulario" class="ct-page" aria-labelledby="contato-heading">
    <div class="container ct-layout">

      <div class="ct-head">
        <div class="ct-head-row">
          <h1 id="contato-heading" class="ct-title" data-mf-title data-cx-hero set:html={t.hero.title} />
          <GlassScene variant="orbit" class="ct-orbit" />
        </div>
        <p class="ct-lede hero-animate-3">{t.hero.lede}</p>
      </div>

      <div class="ct-form-card">
        <h2 id="form-heading" class="ct-form-title">{t.form.title}</h2>

        <form id="contact-form" class="ct-form" novalidate data-errors={JSON.stringify(f.errors)} data-sending={f.sending}>
          <p class="form-required-note">{f.requiredNote}</p>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="field-name">{f.name} <span aria-hidden="true">*</span></label>
              <input class="form-input" type="text" id="field-name" name="name" autocomplete="name" placeholder={f.namePlaceholder} required minlength="2" aria-describedby="error-name">
              <span class="form-error" id="error-name" aria-live="polite"></span>
            </div>
            <div class="form-group">
              <label class="form-label" for="field-company">{f.company} <span aria-hidden="true">*</span></label>
              <input class="form-input" type="text" id="field-company" name="company" autocomplete="organization" placeholder={f.companyPlaceholder} required minlength="2" aria-describedby="error-company">
              <span class="form-error" id="error-company" aria-live="polite"></span>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="field-email">{f.email} <span aria-hidden="true">*</span></label>
              <input class="form-input" type="email" id="field-email" name="email" autocomplete="email" placeholder={f.emailPlaceholder} required aria-describedby="error-email">
              <span class="form-error" id="error-email" aria-live="polite"></span>
            </div>
            <div class="form-group">
              <label class="form-label" for="field-phone">{f.phone} <span aria-hidden="true">*</span></label>
              <input class="form-input" type="tel" id="field-phone" name="phone" autocomplete="tel" placeholder={f.phonePlaceholder} required data-phone aria-describedby="error-phone">
              <span class="form-error" id="error-phone" aria-live="polite"></span>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="field-revenue">{f.revenue} <span aria-hidden="true">*</span></label>
              <select class="form-select" id="field-revenue" name="revenue" required aria-describedby="hint-revenue error-revenue">
                <option value="" disabled selected>{f.revenuePrompt}</option>
                {f.revenueOptions.map((label, i) => <option value={revenueValues[i]}>{label}</option>)}
              </select>
              <span class="form-hint" id="hint-revenue">{f.revenueHint}</span>
              <span class="form-error" id="error-revenue" aria-live="polite"></span>
            </div>
            <div class="form-group">
              <label class="form-label" for="field-source">{f.source}</label>
              <select class="form-select" id="field-source" name="source">
                <option value="" selected>{f.sourcePrompt}</option>
                {f.sourceOptions.map((label, i) => <option value={sourceValues[i]}>{label}</option>)}
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="field-message">{f.message} <span class="form-optional">({f.optional})</span></label>
            <textarea class="form-textarea" id="field-message" name="message" placeholder={f.messagePlaceholder}></textarea>
          </div>

          <p class="form-status visually-hidden" aria-live="polite" data-form-status></p>
          <div class="form-network-error" role="alert" data-network-error hidden>
            <p>{f.errors.network}</p>
            <a href={whatsapp} target="_blank" rel="noopener">{f.successCta} ↗</a>
          </div>

          <div class="ct-submit">
            <button type="submit" class="btn btn-primary btn-lg" id="submit-btn" data-label={f.submit}>
              <span data-submit-label>{f.submit}</span> <span class="btn-arrow" aria-hidden="true">→</span>
            </button>
            <p class="ct-legal">{f.legalPre} <a href={localizedHref('/privacidade', locale)}>{f.legalLink}</a>{f.legalPost}</p>
          </div>
        </form>

        <div class="ct-success" id="form-success" role="status" tabindex="-1" hidden>
          <div class="modal-diag-success-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="28" height="28"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
          <h3>{f.successTitle}</h3>
          <p>{f.successText}</p>
          <a class="btn btn-secondary" href={whatsapp} target="_blank" rel="noopener">{f.successCta} <span class="btn-arrow" aria-hidden="true">↗</span></a>
        </div>
      </div>

      <div class="ct-channels-block">
        <h2 class="ct-block-title">{t.channels.title}</h2>
        <div class="ct-channels">
          <a class="ct-channel" href={whatsapp} target="_blank" rel="noopener" data-glow>
            <span class="ct-channel-icon" aria-hidden="true"><i data-lucide="message-circle"></i></span>
            <span class="ct-channel-body">
              <strong>{t.channels.whatsapp.label}</strong>
              <span class="ct-channel-meta">{WHATSAPP_DISPLAY}</span>
            </span>
            <svg class="ct-channel-arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </a>
          <a class="ct-channel" href={`mailto:${EMAIL}`} data-glow>
            <span class="ct-channel-icon" aria-hidden="true"><i data-lucide="mail"></i></span>
            <span class="ct-channel-body">
              <strong>{t.channels.email.label}</strong>
              <span class="ct-channel-meta">{EMAIL}</span>
            </span>
            <svg class="ct-channel-arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </a>
        </div>
      </div>

    </div>
  </section>


  <!-- Formulário de contato: mesmas regras do modal, envio para o webhook -->
  <script>
    import { maskBrazilPhone, submitLead } from '../scripts/leads';

    const form = document.getElementById('contact-form') as HTMLFormElement | null;

    if (form) {
      const errors = JSON.parse(form.dataset.errors || '{}') as Record<string, string>;
      const successMsg = document.getElementById('form-success');
      const status = form.querySelector<HTMLElement>('[data-form-status]');
      const networkError = form.querySelector<HTMLElement>('[data-network-error]');
      const submitBtn = form.querySelector<HTMLButtonElement>('[type="submit"]');
      const submitLabel = submitBtn?.querySelector<HTMLElement>('[data-submit-label]') || null;
      const fields = [...form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[required]')];
      const phone = form.querySelector<HTMLInputElement>('[data-phone]');
      if (phone && document.documentElement.lang.startsWith('pt')) maskBrazilPhone(phone);

      const messageFor = (field: HTMLInputElement | HTMLSelectElement) => {
        const value = field.value.trim();
        if (!value) return errors.required;
        if (field.type === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) return errors.email;
        if (field.hasAttribute('data-phone') && value.replace(/\D/g, '').length < 10) return errors.phone;
        if (field.minLength > 0 && value.length < field.minLength) return errors.minChars;
        return '';
      };

      const validate = (field: HTMLInputElement | HTMLSelectElement) => {
        const message = messageFor(field);
        const group = field.closest('.form-group');
        group?.classList.toggle('has-error', Boolean(message));
        field.setAttribute('aria-invalid', String(Boolean(message)));
        const error = group?.querySelector('.form-error');
        if (error) error.textContent = message;
        return !message;
      };

      fields.forEach((field) => {
        field.addEventListener('blur', () => { if (field.value) validate(field); });
        field.addEventListener('input', () => { if (field.closest('.has-error')) validate(field); });
      });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const valid = fields.map(validate).every(Boolean);
        if (!valid) {
          if (status) status.textContent = errors.review;
          form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
          return;
        }

        const params = new URLSearchParams(location.search);
        const data = {
          ...Object.fromEntries([...new FormData(form).entries()].map(([key, value]) => [key, String(value).trim()])),
          form: 'contato',
          page_url: location.href,
          referrer: document.referrer || '',
          utm_source: params.get('utm_source') || '',
          utm_medium: params.get('utm_medium') || '',
          utm_campaign: params.get('utm_campaign') || '',
          submitted_at: new Date().toISOString(),
        };

        if (networkError) networkError.hidden = true;
        if (submitBtn) submitBtn.disabled = true;
        if (submitLabel) submitLabel.textContent = form.dataset.sending || '';

        try {
          await submitLead(data);
          form.hidden = true;
          if (successMsg) {
            successMsg.hidden = false;
            successMsg.focus();
          }
          try {
            (window as unknown as { gtag?: (...args: unknown[]) => void }).gtag?.('event', 'form_submit', { event_category: 'contact', event_label: 'diagnostico' });
          } catch { /* analytics opcional */ }
        } catch (error) {
          console.error(error);
          if (networkError) networkError.hidden = false;
        } finally {
          if (submitBtn) submitBtn.disabled = false;
          if (submitLabel) submitLabel.textContent = submitBtn?.dataset.label || '';
        }
      });
    }
  </script>

</BaseLayout>
