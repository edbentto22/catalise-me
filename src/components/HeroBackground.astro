---
// HeroBackground · grade de linhas finas com rastro de células que acendem sob o cursor.
// A grade é desenhada uma vez; o loop só roda enquanto houver células apagando.
interface Props {
  className?: string;
  squareSize?: number;
}

const { className = '', squareSize = 56 } = Astro.props;
---

<div class={`hero-squares-bg ${className}`} data-square-size={squareSize} aria-hidden="true">
  <canvas class="hero-grid-canvas"></canvas>
  <canvas class="hero-trail-canvas"></canvas>
</div>

<script>
  function initHeroGrid() {
    const root = document.querySelector<HTMLElement>('.hero-squares-bg');
    const grid = root?.querySelector<HTMLCanvasElement>('.hero-grid-canvas');
    const trail = root?.querySelector<HTMLCanvasElement>('.hero-trail-canvas');
    const gridCtx = grid?.getContext('2d');
    const trailCtx = trail?.getContext('2d');
    if (!root || !grid || !trail || !gridCtx || !trailCtx) return;

    const size = parseInt(root.dataset.squareSize || '56', 10);
    const interactive = matchMedia('(pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches;
    const cells = new Map<string, number>();
    let width = 0;
    let height = 0;
    let raf = 0;

    const fit = (canvas: HTMLCanvasElement, ctx: CanvasRenderingContext2D) => {
      const dpr = Math.min(2, devicePixelRatio || 1);
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const drawGrid = () => {
      width = root.clientWidth;
      height = root.clientHeight;
      fit(grid, gridCtx);
      fit(trail, trailCtx);
      gridCtx.clearRect(0, 0, width, height);
      gridCtx.strokeStyle = 'rgba(0, 0, 0, 0.055)';
      gridCtx.lineWidth = 1;
      gridCtx.beginPath();
      for (let x = 0; x <= width; x += size) { gridCtx.moveTo(x + 0.5, 0); gridCtx.lineTo(x + 0.5, height); }
      for (let y = 0; y <= height; y += size) { gridCtx.moveTo(0, y + 0.5); gridCtx.lineTo(width, y + 0.5); }
      gridCtx.stroke();
    };

    const drawTrail = () => {
      trailCtx.clearRect(0, 0, width, height);
      cells.forEach((alpha, key) => {
        const [cx, cy] = key.split(':').map(Number);
        trailCtx.fillStyle = `rgba(138, 243, 52, ${alpha * 0.22})`;
        trailCtx.fillRect(cx * size + 1, cy * size + 1, size - 1, size - 1);
        trailCtx.strokeStyle = `rgba(9, 9, 11, ${alpha * 0.22})`;
        trailCtx.strokeRect(cx * size + 0.5, cy * size + 0.5, size, size);
        const next = alpha * 0.93;
        if (next < 0.02) cells.delete(key);
        else cells.set(key, next);
      });
      raf = cells.size ? requestAnimationFrame(drawTrail) : 0;
    };

    drawGrid();
    new ResizeObserver(drawGrid).observe(root);

    if (!interactive) return;
    addEventListener('pointermove', (event) => {
      const rect = root.getBoundingClientRect();
      const x = event.clientX - rect.left;
      const y = event.clientY - rect.top;
      if (x < 0 || y < 0 || x > rect.width || y > rect.height) return;
      cells.set(`${Math.floor(x / size)}:${Math.floor(y / size)}`, 1);
      if (!raf) raf = requestAnimationFrame(drawTrail);
    }, { passive: true });
  }

  initHeroGrid();
</script>

<style>
  .hero-squares-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background: #ffffff;
    /* A grade some nas bordas e atrás do texto principal */
    mask-image: radial-gradient(ellipse 85% 75% at 70% 45%, #000 20%, transparent 85%);
    -webkit-mask-image: radial-gradient(ellipse 85% 75% at 70% 45%, #000 20%, transparent 85%);
  }

  .hero-squares-bg canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
