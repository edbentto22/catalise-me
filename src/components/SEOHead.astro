---
interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogUrl?: string;
  ogImage?: string;
  canonical?: string;
  twitterCard?: string;
  noindex?: boolean;
  keywords?: string;
  locale?: 'pt' | 'en' | 'es';
  localizedPaths?: Partial<Record<'pt' | 'en' | 'es', string>>;
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogUrl,
  ogImage,
  canonical,
  twitterCard = 'summary_large_image',
  noindex = false,
  keywords,
  locale = 'pt',
  localizedPaths,
} = Astro.props;

const localeCodes = { pt: 'pt-BR', en: 'en-US', es: 'es-419' } as const;
const ogLocales = { pt: 'pt_BR', en: 'en_US', es: 'es_LA' } as const;
const image = ogImage || `https://catalise.me/og/og-${locale}.png`;
const imageAlt = { pt: 'Catalise.me · Empresas consultáveis', en: 'Catalise.me · Queryable companies', es: 'Catalise.me · Empresas consultables' }[locale];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://catalise.me/#organization',
      name: 'Catalise.me',
      url: 'https://catalise.me/',
      logo: 'https://catalise.me/assets/icon-512.png',
      slogan: imageAlt.replace('Catalise.me · ', ''),
      email: 'contato@catalise.me',
      contactPoint: [{ '@type': 'ContactPoint', contactType: 'sales', telephone: '+55-75-99187-9786', availableLanguage: ['Portuguese', 'English', 'Spanish'] }],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://catalise.me/#website',
      url: 'https://catalise.me/',
      name: 'Catalise.me',
      inLanguage: localeCodes[locale],
      publisher: { '@id': 'https://catalise.me/#organization' },
    },
  ],
};
const canonicalOrigin = canonical ? new URL(canonical).origin : 'https://catalise.me';
const alternateEntries = localizedPaths ? Object.entries(localizedPaths) as Array<['pt' | 'en' | 'es', string]> : [];
---

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#ffffff">

<!-- SEO -->
<title>{title}</title>
<meta name="description" content={description}>
{keywords && <meta name="keywords" content={keywords}>}
{noindex && <meta name="robots" content="noindex, nofollow">}

<!-- Open Graph -->
<meta property="og:title" content={ogTitle || title} />
<meta property="og:description" content={ogDescription || description} />
<meta property="og:type" content="website">
<meta property="og:locale" content={ogLocales[locale]} />
<meta property="og:site_name" content="Catalise.me" />
{ogUrl && <meta property="og:url" content={ogUrl} />}
<meta property="og:image" content={image}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={imageAlt}>

<!-- Twitter -->
<meta name="twitter:card" content={twitterCard}>
<meta name="twitter:title" content={ogTitle || title}>
<meta name="twitter:description" content={ogDescription || description}>
<meta name="twitter:image" content={image}>
<meta name="twitter:image:alt" content={imageAlt}>

<!-- Canonical -->
{canonical && <link rel="canonical" href={canonical} />}
{alternateEntries.map(([language, path]) => (
  <link rel="alternate" hreflang={localeCodes[language]} href={new URL(path, canonicalOrigin).toString()} />
))}
{localizedPaths?.pt && <link rel="alternate" hreflang="x-default" href={new URL(localizedPaths.pt, canonicalOrigin).toString()} />}


<!-- Ícones -->
<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png">
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">

<!-- Dados estruturados -->
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
