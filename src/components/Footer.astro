---
import { footer, localizedHref, navigation, type Locale } from '../i18n/config';
interface Props { locale?: Locale; }
const { locale = 'pt' } = Astro.props;
const copy = footer[locale];
---

<footer role="contentinfo">
  <div class="container">
    <div class="footer-inner">
      <div class="footer-brand">
        <a href={localizedHref('/', locale)} class="nav-logo" aria-label="Catalise.me">
          <img src="/assets/logo-catalise-me.svg" alt="Catalise.me" class="logo-img" width="120" height="24">
        </a>
        <p>{copy.description}</p>
      </div>

      <div class="footer-links">
        <h4>{copy.pages}</h4>
        <ul>
          <li><a href={localizedHref('/', locale)}>{navigation[locale].home}</a></li>
          <li><a href={localizedHref('/sobre', locale)}>{navigation[locale].about}</a></li>
          <li><a href={localizedHref('/manifesto', locale)}>Manifesto</a></li>
          <li><a href={localizedHref('/contato', locale)}>{navigation[locale].contact}</a></li>
        </ul>
      </div>

      <div class="footer-links">
        <h4>{copy.contact}</h4>
        <ul>
          <li><a href="https://wa.me/5575991879786" target="_blank" rel="noopener">WhatsApp</a></li>
          <li><a href="mailto:contato@catalise.me">contato@catalise.me</a></li>
        </ul>
      </div>
    </div>

    <!-- Linha com logos das aplicações -->
    <div class="footer-apps-bar">
      <span class="footer-apps-label">Nossas Aplicações</span>
      <div class="footer-apps-list" aria-label="Aplicações desenvolvidas pela Catalise.me">
        <div class="app-logo-item" title="Opera aiOS">
          <img src="/assets/apps/logo-app-opera.png" alt="Opera aiOS" class="app-logo-img app-logo-opera" width="57" height="24" loading="lazy" />
        </div>
        <span class="app-sep" aria-hidden="true">/</span>
        <div class="app-logo-item" title="Matika AI CRM">
          <img src="/assets/apps/logo-app-matika.png" alt="Matika AI CRM" class="app-logo-img app-logo-matika" width="81" height="22" loading="lazy" />
        </div>
        <span class="app-sep" aria-hidden="true">/</span>
        <div class="app-logo-item" title="BrandQuest by catalise.me">
          <img src="/assets/apps/logo-app-brandquest.png" alt="BrandQuest by catalise.me" class="app-logo-img app-logo-brandquest" width="97" height="20" loading="lazy" />
        </div>
        <span class="app-sep" aria-hidden="true">/</span>
        <div class="app-logo-item" title="Yugen">
          <img src="/assets/apps/logo-app-yugen.png" alt="Yugen" class="app-logo-img app-logo-yugen" width="75" height="21" loading="lazy" />
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copy">© 2026 Catalise.me · {copy.rights}</p>
    </div>
  </div>
</footer>
