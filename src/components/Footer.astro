---
import { localizedHref, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';

interface Props { locale?: Locale; }
const { locale = 'pt' } = Astro.props;
const t = ui[locale];
const year = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="container footer-bottom">
    <p>© {year} Catalise.me · {t.footerRights} · <a href={localizedHref('/privacidade', locale)}>{t.footerPrivacy}</a></p>
    <a href="#main-content" class="footer-top link-roll" data-scroll-top>
      <span class="roll" data-text={t.footerTop}><span>{t.footerTop}</span></span>
      <span aria-hidden="true">↑</span>
    </a>
  </div>
</footer>
