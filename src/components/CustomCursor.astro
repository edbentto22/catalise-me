---
// CustomCursor.astro — Award-winning Minimalist Magnetic Cursor (BASIC/DEPT® + Artistsweb style)
---

<div class="custom-cursor" id="custom-cursor" aria-hidden="true">
  <div class="cursor-dot"></div>
  <div class="cursor-ring">
    <span class="cursor-label" id="cursor-label"></span>
  </div>
</div>

<style>
  .custom-cursor {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 99999;
    will-change: transform;
    display: none;
  }

  @media (pointer: fine) {
    .custom-cursor {
      display: block;
    }
  }

  .cursor-dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 6px;
    height: 6px;
    background: #ffffff;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    transition: opacity 0.2s ease, transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.9);
  }

  .cursor-ring {
    position: absolute;
    top: 0;
    left: 0;
    width: 36px;
    height: 36px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      width 0.28s cubic-bezier(0.16, 1, 0.3, 1),
      height 0.28s cubic-bezier(0.16, 1, 0.3, 1),
      background 0.25s ease,
      border-color 0.25s ease;
  }

  .cursor-label {
    color: #070709;
    font-family: var(--font-body, sans-serif);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
    white-space: nowrap;
    user-select: none;
  }

  /* Interactive States */
  .custom-cursor.is-hover .cursor-dot {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.2);
  }

  .custom-cursor.is-hover .cursor-ring {
    width: 54px;
    height: 54px;
    border-color: #ffffff;
    background: rgba(255, 255, 255, 0.12);
  }

  .custom-cursor.has-label .cursor-dot {
    opacity: 0;
  }

  .custom-cursor.has-label .cursor-ring {
    width: 90px;
    height: 90px;
    background: #ffffff;
    border-color: #ffffff;
    box-shadow: 0 0 32px rgba(255, 255, 255, 0.35);
  }

  .custom-cursor.has-label .cursor-label {
    opacity: 1;
  }

  .custom-cursor.is-down .cursor-ring {
    transform: translate(-50%, -50%) scale(0.85);
  }
</style>
