---
// Cursor editorial: ponto e anel em mix-blend-mode difference (inverte sobre branco e preto).
---

<div class="custom-cursor" id="custom-cursor" aria-hidden="true">
  <div class="cursor-dot"></div>
  <div class="cursor-ring">
    <span class="cursor-label" id="cursor-label"></span>
  </div>
</div>

<style>
  .custom-cursor {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: var(--z-cursor);
    display: none;
  }

  @media (pointer: fine) and (prefers-reduced-motion: no-preference) {
    html.js-enabled .custom-cursor { display: block; }
  }

  .cursor-dot,
  .cursor-ring {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 50%;
    will-change: transform;
  }

  .cursor-dot {
    width: 6px;
    height: 6px;
    margin: -3px 0 0 -3px;
    background: #ffffff;
    mix-blend-mode: difference;
    transition: opacity 0.2s ease, scale 0.25s var(--ease-out);
  }

  .cursor-ring {
    width: 34px;
    height: 34px;
    margin: -17px 0 0 -17px;
    border: 1px solid #ffffff;
    mix-blend-mode: difference;
    display: grid;
    place-items: center;
    transition:
      scale 0.35s var(--ease-out),
      background 0.25s ease,
      border-color 0.25s ease;
  }

  .cursor-label {
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  .custom-cursor.is-hover .cursor-dot { opacity: 0; scale: 0.3; }
  .custom-cursor.is-hover .cursor-ring { scale: 1.6; background: #ffffff; }

  .custom-cursor.has-label .cursor-dot { opacity: 0; }
  .custom-cursor.has-label .cursor-ring {
    scale: 2.4;
    background: var(--lime);
    border-color: var(--lime);
    mix-blend-mode: normal;
  }
  .custom-cursor.has-label .cursor-label { opacity: 1; scale: calc(1 / 2.4); }

  .custom-cursor.is-down .cursor-ring { scale: 0.8; }
  .custom-cursor.is-hidden { opacity: 0; }
</style>
