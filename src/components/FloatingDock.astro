---
interface Props {
  locale?: string;
}

const { locale = 'pt' } = Astro.props;

const texts = {
  pt: {
    badge: '⚡ OPERA OS',
    label: 'Diagnóstico Gratuito: descubra gargalos automatizáveis.',
    cta: 'Agendar Sessão',
    close: 'Fechar aviso',
  },
  en: {
    badge: '⚡ OPERA OS',
    label: 'Free Diagnosis: discover automatable bottlenecks.',
    cta: 'Book Session',
    close: 'Close notification',
  },
  es: {
    badge: '⚡ OPERA OS',
    label: 'Diagnóstico Gratuito: descubra cuellos de botella automatizables.',
    cta: 'Agendar Sesión',
    close: 'Cerrar aviso',
  },
}[locale as 'pt' | 'en' | 'es'] || {
  badge: '⚡ OPERA OS',
  label: 'Diagnóstico Gratuito: descubra gargalos automatizáveis.',
  cta: 'Agendar Sessão',
  close: 'Fechar aviso',
};
---

<aside class="floating-dock-wrap" id="floating-action-dock" aria-label="Ação rápida de diagnóstico" role="complementary">
  <div class="floating-dock-pill">
    <div class="dock-badge">
      <span class="dock-badge-pulse" aria-hidden="true"></span>
      <span class="dock-badge-text">{texts.badge}</span>
    </div>
    
    <p class="dock-label">
      {texts.label}
    </p>

    <div class="dock-actions">
      <button
        type="button"
        class="dock-cta-btn btn-primary"
        data-open-modal
        id="dock-cta-trigger"
      >
        <span>{texts.cta}</span>
        <span class="btn-arrow" aria-hidden="true">→</span>
      </button>

      <button
        type="button"
        class="dock-close-btn"
        id="dock-dismiss-btn"
        aria-label={texts.close}
        title={texts.close}
      >
        <span aria-hidden="true">×</span>
      </button>
    </div>
  </div>
</aside>

<script>
  const dock = document.getElementById('floating-action-dock');
  const dismissBtn = document.getElementById('dock-dismiss-btn');

  dismissBtn?.addEventListener('click', () => {
    if (!dock) return;
    dock.style.display = 'none';
  });
</script>

<style>
  .floating-dock-wrap {
    position: fixed;
    bottom: 24px;
    left: 50%;
    /* Centraliza com a propriedade translate: o motion anima só o transform (y) */
    translate: -50% 0;
    transform: translateY(60px);
    opacity: 0;
    pointer-events: none;
    z-index: 900;
    width: max-content;
    max-width: calc(100vw - 32px);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .floating-dock-wrap.is-visible {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .floating-dock-pill {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 8px 10px 8px 16px;
    background: rgba(10, 10, 14, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 9999px;
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.06);
  }

  .dock-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 10px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 9999px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: #ffffff;
    white-space: nowrap;
  }

  .dock-badge-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.9);
    animation: dockPulse 2s ease-in-out infinite;
  }

  @keyframes dockPulse {
    0%, 100% { transform: scale(1); opacity: 0.9; }
    50% { transform: scale(1.3); opacity: 0.4; }
  }

  .dock-label {
    margin: 0;
    font-size: 13.5px;
    font-weight: 450;
    color: rgba(255, 255, 255, 0.85);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .dock-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .dock-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 600;
    border-radius: 9999px;
    background: #ffffff;
    color: #070709;
    border: 1px solid #ffffff;
    cursor: pointer;
    box-shadow: 0 2px 12px rgba(255, 255, 255, 0.15);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), background 0.2s ease, box-shadow 0.2s ease;
  }

  .dock-cta-btn:hover {
    background: #f4f4f5;
    box-shadow: 0 4px 20px rgba(255, 255, 255, 0.3);
  }

  .dock-cta-btn .btn-arrow {
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .dock-cta-btn:hover .btn-arrow {
    transform: translateX(3px);
  }

  .dock-close-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: none;
    background: transparent;
    color: #6b7280;
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    border-radius: 50%;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .dock-close-btn:hover {
    color: #e5e7eb;
    background: rgba(255, 255, 255, 0.08);
  }

  @media (max-width: 820px) {
    .floating-dock-wrap {
      bottom: 16px;
      width: calc(100vw - 24px);
    }

    .floating-dock-pill {
      padding: 6px 8px 6px 12px;
      gap: 10px;
    }

    .dock-label {
      display: none; /* Hide label on mobile to keep compact pill */
    }

    .dock-cta-btn {
      padding: 8px 14px;
      font-size: 12.5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-dock-wrap {
      transition: opacity 0.2s linear;
    }
    .dock-badge-pulse {
      animation: none;
    }
  }
</style>
