---
// Modal de contato — injected on pages that have CTA buttons
---

<script>
import { maskBrazilPhone, submitLead } from '../scripts/leads';
import { leadForm, revenueValues, sourceValues } from '../i18n/content/leadForm';
/* =========================================
   CATALISE.ME — MODAL DE CONTATO
   ES Module — compatível com Astro build
   ========================================= */

/* ─── Seletores de botões que devem abrir o modal ─── */
const TRIGGER_SELECTORS = [
  '[data-open-modal]',
  '#hero-cta-primary',
  '#final-cta-primary',
  '#opera-hero-cta',
  '#opera-final-cta',
  '#comecar-cta',
  '#pricing-cta-primary',
  '#sobre-cta-primary',
  '#sticky-cta-btn',
  '.nav-cta-modal',
  '.mobile-cta-modal',
];

const locale = document.documentElement.lang.startsWith('en') ? 'en' : document.documentElement.lang.startsWith('es') ? 'es' : 'pt';
const modalCopy = {
  pt: { close: 'Fechar', title: 'Vamos tornar sua empresa', accent: 'consultável.', lede: 'Conte sobre a sua empresa e o que deseja construir com IA.', discard: 'Descartar os dados preenchidos?' },
  en: { close: 'Close', title: "Let's make your company", accent: 'queryable.', lede: 'Tell us about your company and what you want to build with AI.', discard: 'Discard the information you entered?' },
  es: { close: 'Cerrar', title: 'Hagamos su empresa', accent: 'consultable.', lede: 'Cuéntenos sobre su empresa y lo que desea construir con IA.', discard: '¿Descartar los datos ingresados?' },
}[locale];
const copy = { ...leadForm[locale], ...modalCopy };
const privacyHref = locale === 'pt' ? '/privacidade' : `/${locale}/privacidade`;
const whatsappHref = 'https://wa.me/5575991879786';

const field = (id: string, label: string, control: string, extra = '') => `
  <div class="form-group">
    <label class="form-label" for="${id}">${label}</label>
    ${control}
    ${extra}
    <span class="form-error" id="${id}-error" aria-live="polite"></span>
  </div>`;
const req = (label: string) => `${label} <span aria-hidden="true">*</span>`;

/* ─── Cria o HTML do modal ─── */
function createModal() {
  const el = document.createElement('div');
  el.id = 'modal-diagnostico';
  el.className = 'modal-diag-overlay';
  el.setAttribute('role', 'dialog');
  el.setAttribute('aria-modal', 'true');
  el.setAttribute('aria-labelledby', 'modal-diag-title');
  el.setAttribute('hidden', '');
  el.innerHTML = `
    <div class="modal-diag-box" role="document">
      <button type="button" class="modal-diag-close" id="modal-diag-close" aria-label="${copy.close}">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
      </button>
      <header class="modal-diag-head">
        <h2 id="modal-diag-title" class="modal-diag-title" tabindex="-1">
          ${copy.title} <em>${copy.accent}</em>
        </h2>
        <p class="modal-diag-lede">${copy.lede}</p>
      </header>
      <form id="modal-diag-form" class="modal-diag-form" novalidate aria-describedby="modal-diag-status">
        <p class="form-required-note">${copy.requiredNote}</p>
        <p id="modal-diag-status" class="visually-hidden" aria-live="polite"></p>
        <div class="form-row">
          ${field('diag-name', req(copy.name), `<input class="form-input" type="text" id="diag-name" name="name" placeholder="${copy.namePlaceholder}" required minlength="2" autocomplete="name" aria-describedby="diag-name-error">`)}
          ${field('diag-company', req(copy.company), `<input class="form-input" type="text" id="diag-company" name="company" placeholder="${copy.companyPlaceholder}" required minlength="2" autocomplete="organization" aria-describedby="diag-company-error">`)}
        </div>
        <div class="form-row">
          ${field('diag-email', req(copy.email), `<input class="form-input" type="email" id="diag-email" name="email" placeholder="${copy.emailPlaceholder}" required autocomplete="email" aria-describedby="diag-email-error">`)}
          ${field('diag-phone', req(copy.phone), `<input class="form-input" type="tel" id="diag-phone" name="phone" placeholder="${copy.phonePlaceholder}" required data-phone autocomplete="tel" aria-describedby="diag-phone-error">`)}
        </div>
        <div class="form-row">
          ${field('diag-revenue', req(copy.revenue), `<select class="form-select" id="diag-revenue" name="revenue" required aria-describedby="diag-revenue-hint diag-revenue-error">
            <option value="" disabled selected>${copy.revenuePrompt}</option>
            ${copy.revenueOptions.map((label, i) => `<option value="${revenueValues[i]}">${label}</option>`).join('')}
          </select>`, `<span class="form-hint" id="diag-revenue-hint">${copy.revenueHint}</span>`)}
          ${field('diag-source', copy.source, `<select class="form-select" id="diag-source" name="source">
            <option value="" selected>${copy.sourcePrompt}</option>
            ${copy.sourceOptions.map((label, i) => `<option value="${sourceValues[i]}">${label}</option>`).join('')}
          </select>`)}
        </div>
        <div class="form-network-error" id="modal-diag-network-error" role="alert" hidden>
          <p>${copy.errors.network}</p>
          <a href="${whatsappHref}" target="_blank" rel="noopener">${copy.successCta} ↗</a>
        </div>
        <button type="submit" class="modal-diag-submit" id="modal-diag-submit">
          <span data-submit-label>${copy.submit}</span>
        </button>
        <p class="modal-diag-legal">${copy.legalPre} <a href="${privacyHref}">${copy.legalLink}</a>${copy.legalPost}</p>
      </form>
      <div class="modal-diag-success" id="modal-diag-success" role="status" aria-live="polite" tabindex="-1" hidden>
        <div class="modal-diag-success-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="28" height="28"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
        <h3 tabindex="-1">${copy.successTitle}</h3>
        <p>${copy.successText}</p>
        <div class="modal-diag-success-actions">
          <a class="modal-diag-submit" href="${whatsappHref}" target="_blank" rel="noopener">${copy.successCta} ↗</a>
          <button type="button" class="modal-diag-secondary" id="modal-diag-success-close">${copy.close}</button>
        </div>
      </div>
    </div>
  `;
  return el;
}

/* ─── Estado do modal ─── */
let modal: HTMLElement | null = null;
let previousFocus: Element | null = null;

function openModal() {
  if (!modal) return;
  previousFocus = document.activeElement;
  const form = modal.querySelector<HTMLFormElement>('#modal-diag-form');
  const success = modal.querySelector<HTMLElement>('#modal-diag-success');
  const networkError = modal.querySelector<HTMLElement>('#modal-diag-network-error');
  const submit = form?.querySelector<HTMLButtonElement>('[type=submit]');
  if (success && !success.hidden && form) {
    form.reset();
    form.hidden = false;
    success.hidden = true;
  }
  if (networkError) networkError.hidden = true;
  if (submit) {
    submit.disabled = false;
    const label = submit.querySelector<HTMLElement>('[data-submit-label]');
    if (label) label.textContent = copy.submit;
  }
  modal.removeAttribute('hidden');
  document.body.classList.add('modal-open');
  modal.offsetHeight; // força reflow
  modal.classList.add('is-open');
  setTimeout(() => {
    if (!modal?.classList.contains('is-open')) return;
    const first = modal!.querySelector<HTMLElement>('#modal-diag-title, input, select, button');
    if (first) first.focus();
  }, 80);
}

function closeModal() {
  if (!modal) return;
  const form = modal.querySelector<HTMLFormElement>('#modal-diag-form');
  if (form && !form.hidden && [...new FormData(form).values()].some((value) => String(value).trim()) &&
      !window.confirm(copy.discard)) return;
  modal.classList.remove('is-open');
  document.body.classList.remove('modal-open');
  const hideClosedModal = () => {
    if (!modal?.classList.contains('is-open')) modal?.setAttribute('hidden', '');
  };
  modal.addEventListener('transitionend', hideClosedModal, { once: true });
  setTimeout(hideClosedModal, 450);
  if (previousFocus instanceof HTMLElement) previousFocus.focus();
}

/* ─── Submissão ─── */
async function handleSubmit(e: Event) {
  e.preventDefault();
  const form = e.target as HTMLFormElement;
  const btn = form.querySelector<HTMLButtonElement>('[type=submit]');
  const requiredFields = [...form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[required]')];
  const validateField = (field: HTMLInputElement | HTMLSelectElement) => {
    const value = field.value.trim();
    let message = '';
    if (!value) message = copy.errors.required;
    else if (field.type === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) message = copy.errors.email;
    else if (field.hasAttribute('data-phone') && value.replace(/\D/g, '').length < 10) message = copy.errors.phone;
    else if (field.minLength > 0 && value.length < field.minLength) message = copy.errors.minChars;
    field.setAttribute('aria-invalid', String(Boolean(message)));
    const error = form.querySelector<HTMLElement>(`#${field.id}-error`);
    if (error) error.textContent = message;
    return !message;
  };
  requiredFields.forEach(validateField);
  const firstInvalid = requiredFields.find((field) => field.getAttribute('aria-invalid') === 'true');
  if (firstInvalid) {
    (form.querySelector('#modal-diag-status') as HTMLElement).textContent = copy.errors.review;
    firstInvalid.focus();
    return;
  }
  if (!btn) return;

  const label = btn.querySelector<HTMLElement>('[data-submit-label]') || btn;
  label.textContent = copy.sending;
  btn.disabled = true;
  btn.classList.add('is-sending');
  const networkError = form.querySelector<HTMLElement>('#modal-diag-network-error');
  if (networkError) networkError.hidden = true;

  const params = new URLSearchParams(location.search);
  const body = {
    ...Object.fromEntries([...new FormData(form).entries()].map(([key, value]) => [key, String(value).trim()])),
    form: 'modal',
    page_url: location.href,
    referrer: document.referrer || '',
    utm_source: params.get('utm_source') || '',
    utm_medium: params.get('utm_medium') || '',
    utm_campaign: params.get('utm_campaign') || '',
    submitted_at: new Date().toISOString(),
  };

  try {
    await submitLead(body);
    form.hidden = true;
    const success = document.getElementById('modal-diag-success')!;
    success.hidden = false;
    success.focus();
  } catch (err) {
    console.error('[Modal Diagnóstico] Erro ao enviar:', err);
    if (networkError) networkError.hidden = false;
  } finally {
    label.textContent = copy.submit;
    btn.disabled = false;
    btn.classList.remove('is-sending');
  }
}

/* ─── Trap de foco ─── */
function trapFocus(e: KeyboardEvent) {
  if (!modal || !modal.classList.contains('is-open')) return;
  const focusable = [...modal.querySelectorAll<HTMLElement>(
    'button, input, select, textarea, [tabindex]:not([tabindex="-1"])'
  )].filter(el => !el.hasAttribute('disabled') && !el.closest('[hidden]') && el.getClientRects().length > 0);
  const first = focusable[0];
  const last  = focusable[focusable.length - 1];
  if (e.key === 'Tab') {
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault(); last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault(); first.focus();
    }
  }
  if (e.key === 'Escape') closeModal();
}

/* ─── Inicialização ─── */
function init() {
  modal = createModal();
  document.body.appendChild(modal);

  modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
  modal.querySelector('#modal-diag-close')!.addEventListener('click', closeModal);
  modal.querySelector('#modal-diag-success-close')!.addEventListener('click', closeModal);
  modal.querySelector('#modal-diag-form')!.addEventListener('submit', handleSubmit);
  if (locale === 'pt') maskBrazilPhone(modal.querySelector<HTMLInputElement>('#diag-phone')!);
  modal.querySelectorAll<HTMLInputElement | HTMLSelectElement>('#modal-diag-form [required]').forEach((field) => {
    field.addEventListener('input', () => {
      if (field.getAttribute('aria-invalid') !== 'true') return;
      field.setAttribute('aria-invalid', 'false');
      const error = modal!.querySelector<HTMLElement>(`#${field.id}-error`);
      if (error) error.textContent = '';
    });
  });
  document.addEventListener('keydown', trapFocus);

  // Delegação: cobre [data-open-modal] e os seletores legados, inclusive elementos criados depois.
  document.addEventListener('click', (e) => {
    const target = (e.target as Element | null)?.closest(TRIGGER_SELECTORS.join(','));
    if (!target) return;
    if (e instanceof MouseEvent && (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey)) return;
    e.preventDefault();
    document.dispatchEvent(new CustomEvent('cx:menu-close'));
    openModal();
  });

  // Links comuns continuam apontando para /contato como fallback progressivo.
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', init);
} else {
  init();
}
</script>
