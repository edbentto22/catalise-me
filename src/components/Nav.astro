---
import { locales, localizedHref, navigation, type Locale } from '../i18n/config';
import { ui, EMAIL, whatsappLink } from '../i18n/ui';

interface Props {
  currentPath?: string;
  locale?: Locale;
  localizedPaths?: Partial<Record<Locale, string>>;
}

const { currentPath = '/', locale = 'pt', localizedPaths } = Astro.props;
const t = ui[locale];
const nav = navigation[locale];

const links = [
  { href: '/', label: nav.home },
  { href: '/manifesto', label: nav.manifesto },
  { href: '/sobre', label: nav.about },
];
const mobileLinks = [...links, { href: '/contato', label: nav.contact }];

const currentBasePath = locale === 'pt' ? currentPath : currentPath.replace(new RegExp(`^/${locale}(?=/|$)`), '') || '/';

function isActive(linkHref: string): boolean {
  if (linkHref === '/') return currentBasePath === '/' || currentBasePath === '/index.html';
  return currentBasePath === linkHref || currentBasePath.startsWith(`${linkHref}/`);
}
---

<header class="nav" data-nav>
  <nav class="nav-inner" aria-label={t.navLabel}>
    <a href={localizedHref('/', locale)} class="nav-logo" aria-label="Catalise.me">
      <img src="/assets/logo-catalise-me.svg" alt="Catalise.me" class="nav-logo-img theme-light-only" width="420" height="84">
      <img src="/assets/logo-catalise-me-on-dark.svg" alt="Catalise.me" class="nav-logo-img theme-dark-only" width="420" height="84">
    </a>

    <ul class="nav-links" role="list">
      {links.map((link) => (
        <li>
          <a
            href={localizedHref(link.href, locale)}
            class:list={['nav-link', { active: isActive(link.href) }]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            <span class="roll" data-text={link.label}><span>{link.label}</span></span>
          </a>
        </li>
      ))}
    </ul>

    <div class="nav-right">
      {localizedPaths && (
        <div class="nav-language" role="group" aria-label={t.languageLabel}>
          {(Object.keys(localizedPaths) as Locale[]).map((language) => (
            <a href={localizedPaths[language]} hreflang={locales[language].code} lang={locales[language].code} aria-current={language === locale ? 'true' : undefined}>{locales[language].label}</a>
          ))}
        </div>
      )}

      <button type="button" class="theme-toggle nav-theme" role="switch" aria-checked="false" aria-label={t.themeLabel} title={t.themeLabel} data-theme-toggle>
        <span class="theme-toggle-thumb" aria-hidden="true"></span>
        <svg class="theme-toggle-icon theme-toggle-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="3.6" stroke="currentColor" stroke-width="1.6" /><path d="M12 3v1.8M12 19.2V21M5.64 5.64l1.27 1.27M17.09 17.09l1.27 1.27M3 12h1.8M19.2 12H21M5.64 18.36l1.27-1.27M17.09 6.91l1.27-1.27" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
        <svg class="theme-toggle-icon theme-toggle-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true"><path d="M19.5 14.6A7.6 7.6 0 0 1 9.4 4.5a7.6 7.6 0 1 0 10.1 10.1Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
      </button>

      <a href={localizedHref('/contato', locale)} class="nav-contact-btn">
        <span class="roll" data-text={t.contactCta}><span>{t.contactCta}</span></span>
        <svg class="nav-btn-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M2.5 9.5L9.5 2.5M9.5 2.5H4M9.5 2.5V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>

      <button
        type="button"
        class="nav-hamburger"
        aria-label={t.menuOpen}
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-label-open={t.menuOpen}
        data-label-close={t.menuClose}
      >
        <span class="nav-hamburger-label" aria-hidden="true">{t.menuLabel}</span>
        <span class="nav-hamburger-lines" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </nav>
</header>

<!-- Menu em tela cheia (mobile e tablet) -->
<div class="nav-mobile" id="mobile-menu" aria-label={t.navLabel} role="dialog" aria-modal="true" hidden inert>
  <div class="nav-mobile-inner">
    <ol class="nav-mobile-links" role="list">
      {mobileLinks.map((link, i) => (
        <li class="nav-mobile-item">
          <a href={localizedHref(link.href, locale)} aria-current={isActive(link.href) ? 'page' : undefined}>
            <span class="nav-mobile-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="nav-mobile-label">{link.label}</span>
          </a>
        </li>
      ))}
    </ol>

    <div class="nav-mobile-foot">
      <div class="nav-mobile-meta">
        <div>
          <span class="nav-mobile-meta-label">{t.menuWrite}</span>
          <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
          <a href={whatsappLink(t.whatsappDiagnostic)} target="_blank" rel="noopener">WhatsApp ↗</a>
        </div>
        <div class="nav-mobile-prefs">
          <button type="button" class="theme-toggle" role="switch" aria-checked="false" aria-label={t.themeLabel} title={t.themeLabel} data-theme-toggle>
            <span class="theme-toggle-thumb" aria-hidden="true"></span>
            <svg class="theme-toggle-icon theme-toggle-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="3.6" stroke="currentColor" stroke-width="1.6" /><path d="M12 3v1.8M12 19.2V21M5.64 5.64l1.27 1.27M17.09 17.09l1.27 1.27M3 12h1.8M19.2 12H21M5.64 18.36l1.27-1.27M17.09 6.91l1.27-1.27" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
            <svg class="theme-toggle-icon theme-toggle-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true"><path d="M19.5 14.6A7.6 7.6 0 0 1 9.4 4.5a7.6 7.6 0 1 0 10.1 10.1Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
          </button>
          {localizedPaths && (
            <div class="nav-mobile-language" role="group" aria-label={t.languageLabel}>
              {(Object.keys(localizedPaths) as Locale[]).map((language) => (
                <a href={localizedPaths[language]} hreflang={locales[language].code} lang={locales[language].code} aria-current={language === locale ? 'true' : undefined}>{locales[language].label}</a>
              ))}
            </div>
          )}
        </div>
      </div>

      <p class="nav-mobile-tagline">{t.menuTagline}</p>
    </div>
  </div>
</div>
