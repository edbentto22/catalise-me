---
// A static SVG keeps the operation visible when WebGL is unavailable.
---
<div class="hero-3d-container" id="hero-3d-container" aria-hidden="true">
  <svg class="hero-network-fallback" viewBox="0 0 440 150" fill="none">
    <g stroke="#a1a1aa" stroke-width="1">
      <path data-network-link d="M62 36 220 75 60 110 M135 128 220 75 380 112 M220 75 380 38 M220 75 305 22" />
    </g>
    <g fill="#18181b"><circle cx="62" cy="36" r="5" /><circle cx="60" cy="110" r="5" /><circle cx="135" cy="128" r="5" /><circle cx="380" cy="112" r="5" /><circle cx="380" cy="38" r="5" /><circle cx="305" cy="22" r="5" /></g>
    <circle cx="220" cy="75" r="19" stroke="#18181b" stroke-width="2" />
    <circle cx="220" cy="75" r="7" fill="#8af334" />
  </svg>
  <canvas class="hero-3d-canvas" id="hero-3d-canvas"></canvas>
</div>
<script>
  import { hasHardwareWebGL } from '../scripts/gpu';
  const container = document.getElementById('hero-3d-container');
  const canvas = document.getElementById('hero-3d-canvas') as HTMLCanvasElement | null;
  const connection = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
  if (container && canvas && !connection?.saveData && !['2g', 'slow-2g'].includes(connection?.effectiveType || '') && hasHardwareWebGL()) {
    const start = () => import('../scripts/hero3d').then(({ initHero3D }) => {
      const dispose = initHero3D({ canvas, container });
      addEventListener('pagehide', (event) => { if (!event.persisted) dispose?.(); });
    }).catch(() => { container.dataset.state = 'off'; });
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 1200 });
    else setTimeout(start, 300);
  }
</script>
<style>
  .hero-3d-container { position: absolute; inset: 0 0 56px; pointer-events: none; overflow: hidden; }
  .hero-3d-canvas, .hero-network-fallback { width: 100%; height: 100%; position: absolute; inset: 0; }
  .hero-3d-canvas { opacity: 0; }
  .hero-3d-container[data-state='ready'] .hero-3d-canvas { opacity: 1; }
  .hero-3d-container[data-state='ready'] .hero-network-fallback { visibility: hidden; }
</style>
