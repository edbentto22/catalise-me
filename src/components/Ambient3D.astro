---
// Cena 3D ambiente e sutil para páginas internas (Manifesto e Sobre).
interface Props {
  variant: 'converge' | 'strata';
  class?: string;
}
const { variant, class: className = '' } = Astro.props;
---

<div class={`ambient-3d ${className}`} data-ambient={variant} aria-hidden="true">
  <canvas class="ambient-3d-canvas"></canvas>
</div>

<script>
  import { initAmbient3D, type Ambient3DVariant } from '../scripts/ambient3d';

  document.querySelectorAll<HTMLElement>('[data-ambient]').forEach((container) => {
    const canvas = container.querySelector<HTMLCanvasElement>('canvas');
    if (!canvas || container.dataset.state) return;
    container.dataset.state = 'loading';
    initAmbient3D({ canvas, container, variant: container.dataset.ambient as Ambient3DVariant });
  });
</script>

<style>
  .ambient-3d {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    opacity: 0;
    transition: opacity 1.4s cubic-bezier(0.16, 1, 0.3, 1);
    /* Dissolve nas bordas: o objeto nunca "corta" no limite da seção */
    mask-image: radial-gradient(ellipse 70% 75% at 68% 50%, #000 45%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 70% 75% at 68% 50%, #000 45%, transparent 100%);
  }

  .ambient-3d[data-state='ready'] {
    opacity: 1;
  }

  .ambient-3d[data-state='off'] {
    display: none;
  }

  .ambient-3d-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  @media (max-width: 960px) {
    .ambient-3d {
      opacity: 0;
      mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, #000 30%, transparent 100%);
      -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, #000 30%, transparent 100%);
    }

    .ambient-3d[data-state='ready'] {
      opacity: 0.55;
    }
  }
</style>
